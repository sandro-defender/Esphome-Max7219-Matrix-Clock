  "groups": [
    {
      "id": "Device",
      "description": "Identity and local time. Automatic timezone follows this browser, not the device location."
    },
    {
      "id": "Clock",
      "description": "Clock face, time format and digit transitions. Preferences below are first-boot defaults; saved device preferences win after an update."
    },
    {
      "id": "Screens",
      "description": "Choose any built-in screen. Automatic cycling alternates Clock and Date; the Temperature screen uses a numeric Home Assistant sensor in °C."
    },
    {
      "id": "Light",
      "description": "Brightness 0 is the dimmest MAX7219 level, not power off. Night scheduling follows the configured timezone; OTA and boot overlays stay visible."
    },
    {
      "id": "Messages",
      "description": "Scroll speed is milliseconds per pixel: larger values are slower. A default duration of 0 keeps a message until cleared. Preview text is not installed."
    },
    {
      "id": "Hardware",
      "description": "Rebuild after changing wiring or board. Modules must divide evenly into rows. Selecting 180° also reverses the chip chain; change the chain switch separately for unusual wiring."
    },
    {
      "id": "Network",
      "description": "Non-secret options only. SSID and credentials stay in your local secret file. A timeout of 0 disables that automatic reboot or fallback-hotspot timer; this can make recovery harder. Keep the default SNTP interval unless your time server permits more frequent polling."
    },
    {
      "id": "Web server",
      "description": "Optional authenticated device page. Disable it to save flash; native API and encrypted OTA remain available, but the fallback hotspot then has no browser page. Hidden entities stay hidden here too. Web OTA and internal-entity listing remain disabled. HTTP is unencrypted with either authentication method: use a trusted LAN. Digest avoids sending the password directly. Web UI version 1 is deprecated by ESPHome."
    },
    {
      "id": "Advanced",
      "description": "Firmware timing, logs and OTA. A longer redraw interval reduces update frequency and can make animation less smooth. Firmware compilation, flash size and on-device behavior remain unverified."
    }
  ],
  "packages": {
    "webServer": {
      "target": "packages/web_server.yaml",
      "group": "Web server",
      "label": "Device web server",
      "input": "boolean"
    }
