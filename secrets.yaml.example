# Copy this file to secrets.yaml (same directory as your clock YAML or the
# checkout you run ESPHome from) and replace every value with your own.
#
# secrets.yaml is git-ignored. Never commit real credentials, and never copy
# this file into a remote package: remote packages cannot resolve !secret and
# must receive their values as substitutions from your local YAML.

# --- Wi-Fi ---------------------------------------------------------------
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# --- Native API encryption ------------------------------------------------
# Generate a new key with:
#   esphome generate-encryption-key      (also shown by `esphome run` if empty)
# Use the existing key when migrating an already-installed device, otherwise
# Home Assistant loses the connection and the encryption key has to be
# re-entered in the ESPHome integration.
api_encryption_key: "REPLACE_WITH_A_BASE64_32_BYTE_KEY="

# --- Fallback access point ------------------------------------------------
# Used when the clock cannot reach the configured Wi-Fi network.
fallback_ap_password: "FallbackHotspotPassword"

# --- Optional web server login --------------------------------------------
# Only needed when you keep packages/web_server.yaml in the file list.
web_server_username: "admin"
web_server_password: "ChangeThisWebPassword"
